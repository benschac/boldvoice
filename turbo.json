{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "env": ["EXPO_PUBLIC_*"],
      "outputs": ["dist/**"]
    },
    "transit": { "dependsOn": ["^transit"] },
    "lint": { "dependsOn": ["transit"] },
    "typecheck": { "dependsOn": ["transit"] },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["EXPO_PUBLIC_*", "REACT_NATIVE_PACKAGER_HOSTNAME"]
    },
    "ios": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["EXPO_PUBLIC_*"]
    },
    "android": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["EXPO_PUBLIC_*"]
    },
    "web": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["EXPO_PUBLIC_*"]
    }
  }
}
